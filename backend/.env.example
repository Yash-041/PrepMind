# Application & Server
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/prepmind

# JWT Security
JWT_SECRET_KEY=replace-with-a-secure-64-char-hex-secret-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google OAuth (Leave empty if testing email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI / LLM & Embedding Configuration
# Default chat model: LLM_PROVIDER (groq | gemini) + LLM_MODEL. LLM_API_KEY is the Gemini key (also used for embeddings).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Supported EMBEDDING_PROVIDER: gemini | openai | mock
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Email (Gmail SMTP). SMTP_PASSWORD is a 16-character Gmail App Password, not your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Leave SMTP_USER empty to print verification links in the server console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=PrepMind AI

# Groq (chat answers). Embeddings still use Gemini.
GROQ_API_KEY=
