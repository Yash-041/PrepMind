# Copy to frontend/.env. Only public values belong here: Vite builds them into the page.
# Backend address; leave empty to use the same origin (Vite dev proxy or Docker nginx).
VITE_API_BASE_URL=
# Google OAuth 2.0 Web client ID (same value as GOOGLE_CLIENT_ID in backend/.env). Empty hides the Google button.
VITE_GOOGLE_CLIENT_ID=
